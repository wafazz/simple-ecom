# Basic Custom E-Commerce — see Planning.md §17.5
# Placeholders only. Never commit real secrets (spec §31).

APP_NAME="Basic Custom E-Commerce"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Planning §15 — daily channel, 14-day retention
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_DAILY_DAYS=14
LOG_LEVEL=info

# Planning §17.7 — production target is MySQL 8.0 on the VPS.
# On a MariaDB host use DB_CONNECTION=mariadb (NOT mysql): under the mysql
# driver, renameColumn() is a hard syntax error on MariaDB <= 10.5.2.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=basic_ecom
DB_USERNAME=
DB_PASSWORD=

# Planning §12.3 — file drivers keep the schema to 10 app tables + migrations.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Order relay ---
# A settled order is POSTed here as JSON. Used because this VPS blocks outbound
# SMTP, so the receiving host is the one that can actually send anything out.
# Leave the URL blank and nothing is posted. The receiving script is kept in
# docs/send-email.php and is deployed to THAT host, not this one; the token
# must match RELAY_TOKEN inside it.
ORDER_RELAY_URL=https://penangfc.kopaarena.com/send-email.php
ORDER_RELAY_TOKEN=

# --- Admin seeding (production only) ---
# AdminSeeder REFUSES to run in production without these. Prefer
# `php artisan shop:create-admin`, which never echoes the password.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- ToyyibPay (REQ-005) — Planning §11.A ---
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_SANDBOX=true
# decimal | cents — see Planning §11.A.6 / OQ-11
TOYYIBPAY_AMOUNT_FORMAT=decimal

# --- EasyParcel (REQ-006 / REQ-013) — Planning §11.B.2 ---
# OAuth 2.0, NOT a flat API key. Spec §31's EASYPARCEL_API_KEY is the legacy
# Connect API shape; see OQ-03. Tokens themselves are NOT stored here —
# they rotate at runtime and live encrypted in integration_tokens.
EASYPARCEL_CLIENT_ID=
EASYPARCEL_CLIENT_SECRET=
EASYPARCEL_SANDBOX=true
# kg | g — see Planning §11.B / OQ-13
EASYPARCEL_WEIGHT_UNIT=kg
